FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir xhshow gmssl curl_cffi

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p output downloads logs browser_data config

# Initialize usage tracker
RUN echo '{"license":"trial","total_limit":50,"used":0,"first_use":null,"last_use":null}' > /app/config/usage.json

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/usage || exit 1

EXPOSE 8000

CMD ["python", "-m", "api.main"]
