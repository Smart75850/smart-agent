# ============================================================
# Smart Agent — 环境配置
# ============================================================

# --- DeepSeek API (必须) ---
# 用于 AI 分析（7 Agent），请到 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- QWEN-VL 千问视觉模型 (可选，视频克隆分析用) ---
# 用于 VideoCloneAgent 视频画面分析
# 请到 https://dashscope.aliyun.com 申请
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_MODEL=qwen-vl-max

# --- Canva API (可选，模板搜索用) ---
# 请到 https://www.canva.com/developers 申请
CANVA_API_KEY=your-canva-key-here

# --- 浏览器引擎 ---
# playwright(默认) / cdp(连接已有Chrome) / camoufox(Pro专属反检测)
BROWSER_ENGINE=playwright

# --- 代理 IP (可选) ---
# PROXY_URL=http://user:pass@proxy.example.com:8080

# --- 存储 ---
STORE_BACKEND=csv
OUTPUT_DIR=./output
