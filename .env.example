# ============================================================
# Smart Agent — 环境配置
# ============================================================
# 复制此文件为 .env 并修改对应配置即可。
# AI 分析需要 LLM，不配置则自动降级为模板模式（搜索采集不受影响）。

# --- LLM 配置（选一个即可）---

# 方案一：本地 Ollama（推荐，免费，中文最佳）
# 1. 安装 Ollama: https://ollama.com
# 2. ollama pull qwen3:14b    # 16GB 内存，中文最优
#    ollama pull qwen3:8b     # 8GB 内存，轻量
#    ollama pull qwen3:32b    # 24GB+ 内存，最强
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b

# 方案二：DeepSeek 云端（¥10 起充，效果更强）
# 注册: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-your-key-here

# 方案三：任何 OpenAI 兼容接口
# LLM_API_KEY=your-key
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini


# --- QWEN-VL 千问视觉模型 (可选，视频分析用) ---
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_MODEL=qwen-vl-max


# --- 浏览器引擎 ---
# playwright(默认) / cdp(连接已有Chrome) / auto(自动检测)
BROWSER_ENGINE=auto


# --- 存储 ---
STORE_BACKEND=json
OUTPUT_DIR=./output


# --- 其他可选配置（均有默认值，无需改动）---

# 浏览器 / 抓取
# CDP_PORT=9222
# PAGE_TIMEOUT=30000
# SLEEP_AFTER_LOAD=8
# HTTP3_ENABLED=false

# 代理（选填）
# PROXY_ENABLED=false
# PROXY_URL=

# 下载
# DOWNLOAD_DIR=downloads
# DOWNLOAD_MAX_CONCURRENT=3
# DOWNLOAD_MAX_FILE_MB=500

# 存储
# COOKIE_DIR=browser_data
# LANGGRAPH_CHECKPOINT_DB=output/langgraph_checkpoint.db

# 可选：MySQL 后端
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=smart_agent

# 可选：SignSrv 签名服务 / JS 收割
# SIGN_SRV_ENABLED=true
# SIGN_SRV_PORT=18501
# HARVEST_ENABLED=true
# HARVEST_INTERVAL_HOURS=6

# 可选：Camoufox 反检测浏览器
# CAMOUFOX_HEADLESS=false
# CAMOUFOX_HUMANIZE=true
# CAMOUFOX_OS=windows
# CAMOUFOX_LOCALE=zh-CN


# --- 安全配置 ---

# API 鉴权 Token（强烈建议设置）
# 设置后所有 API 请求需带 Authorization: Bearer <token>，WebSocket 需带 ?token=<token>；
# 未设置时服务仅绑定 127.0.0.1（仅本机可访问）。
# 需局域网/公网访问时：先设 API_TOKEN，再用 API_HOST=0.0.0.0 显式开放。
API_TOKEN=

# Pro license 签名密钥（必须设置才能生成/验证 license key）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_SECRET=

# CookieBridge 同步 Token（可选；设置后 Chrome Extension 需带同值 X-API-Token 请求头）
COOKIE_BRIDGE_TOKEN=

# API 监听地址（默认仅本机）
API_HOST=127.0.0.1

# CORS 允许来源（逗号分隔；默认仅本机 WebUI）
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
