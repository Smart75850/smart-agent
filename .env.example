# ============================================================
# Smart Agent Pro — 环境配置
# ============================================================

# --- DeepSeek API (必须) ---
# 用于 AI 分析（7 Agent），请到 https://platform.deepseek.com 申请
# 费用极低：每次完整分析约 ¥0.01，充值 ¥10 可用一年
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- 签名引擎 (本地运行，无需配置) ---
# 签名服务默认运行在 localhost:9001，无需修改
# SIGN_SRV_URL=http://127.0.0.1:9001

# --- 代理 IP (可选) ---
# 大量采集时建议使用，防止 IP 被平台限制
# 支持 HTTP / HTTPS / SOCKS5 代理
# PROXY_URL=http://user:pass@proxy.example.com:8080

# --- 存储 ---
# 输出格式: csv / json / excel / jsonl / mysql
STORE_BACKEND=csv
OUTPUT_DIR=./output

# --- 浏览器引擎 ---
# playwright(默认) / cdp(连接已有Chrome) / camoufox(Pro专属反检测)
BROWSER_ENGINE=playwright
